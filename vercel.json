{
    "functions": {
        "**/*.php": {
            "runtime": "vercel-php@0.9.0"
        }
    },
    "rewrites": [
        {
            "source": "/dashboard",
            "destination": "/dashboard/dashboard.php"
        },
        {
            "source": "/dashboard/",
            "destination": "/dashboard/dashboard.php"
        }
    ]
}